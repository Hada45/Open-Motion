+package eu.kanade.tachiyomi.ui.setting
+
+import android.os.Bundle
+import android.text.format.Formatter
+import androidx.preference.Preference
+import androidx.preference.PreferenceScreen
+import eu.kanade.tachiyomi.data.preference.SharedPreferencesDataStore
+import eu.kanade.tachiyomi.source.ConfigurableSource
+import eu.kanade.tachiyomi.source.SourceManager
+import eu.kanade.tachiyomi.source.online.all.FtpSource
+import kotlinx.coroutines.launch
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.get
+
+/**
+ * Preference screen for configurable sources that are built into the app rather
+ * than installed as extension APKs.
+ */
+class SourcePreferencesController() : SettingsController() {
+    constructor(sourceId: Long) : this() {
+        args.putLong(SOURCE_ID_KEY, sourceId)
+    }
+
+    private val sourceId: Long
+        get() = args.getLong(SOURCE_ID_KEY)
+
+    private val source: ConfigurableSource?
+        get() = Injekt.get<SourceManager>().get(sourceId) as? ConfigurableSource
+
+    override fun onCreatePreferences(
+        savedInstanceState: Bundle?,
+        rootKey: String?,
+    ) {
+        source?.let { configurable ->
+            preferenceManager.preferenceDataStore =
+                SharedPreferencesDataStore(configurable.getSourcePreferences())
+        }
+        super.onCreatePreferences(savedInstanceState, rootKey)
+    }
+
+    override fun setupPreferenceScreen(screen: PreferenceScreen): PreferenceScreen =
+        screen.apply {
+            val configurable = source
+            title = configurable?.name ?: "Source settings"
+            configurable?.setupPreferenceScreen(this)
+
+            if (configurable is FtpSource) {
+                addPreference(
+                    Preference(context).apply {
+                        key = "ftp_test_connection_action"
+                        title = "Test connection"
+                        summary = "Connect, authenticate, and verify the configured root folder"
+                        isPersistent = false
+
+                        setOnPreferenceClickListener {
+                            isEnabled = false
+                            summary = "Testing…"
+
+                            viewScope.launch {
+                                val result =
+                                    runCatching {
+                                        configurable.testConnection()
+                                    }
+
+                                summary =
+                                    result.fold(
+                                        onSuccess = { it },
+                                        onFailure = {
+                                            "Failed: ${it.message ?: it.javaClass.simpleName}"
+                                        },
+                                    )
+                                isEnabled = true
+                            }
+                            true
+                        }
+                    },
+                )
+
+                addPreference(
+                    Preference(context).apply {
+                        key = "ftp_clear_archive_cache_action"
+                        title = "Clear FTP archive cache"
+                        summary = "Remove locally cached remote CBZ/ZIP files"
+                        isPersistent = false
+
+                        setOnPreferenceClickListener {
+                            isEnabled = false
+                            summary = "Clearing…"
+
+                            viewScope.launch {
+                                val result =
+                                    runCatching {
+                                        configurable.clearArchiveCache()
+                                    }
+
+                                summary =
+                                    result.fold(
+                                        onSuccess = { bytes ->
+                                            "Cleared ${
+                                                Formatter.formatShortFileSize(
+                                                    context,
+                                                    bytes,
+                                                )
+                                            }"
+                                        },
+                                        onFailure = {
+                                            "Failed: ${it.message ?: it.javaClass.simpleName}"
+                                        },
+                                    )
+                                isEnabled = true
+                            }
+                            true
+                        }
+                    },
+                )
+            }
+        }
+
+    companion object {
+        private const val SOURCE_ID_KEY = "source_id"
+    }
+}
+/**
+ * Built-in FTP source for TachiyomiJ2K.
+ *
+ * Supported remote layout:
+ *
+ * root/
+ *   Manga title/
+ *     cover.jpg
+ *     Chapter 001/
+ *       001.jpg
+ *       002.webp
+ *     Chapter 002.cbz
+ *     Chapter 003.zip
+ *
+ * Directory chapters are streamed directly from FTP one page at a time.
+ * CBZ/ZIP chapters are downloaded once to an app-cache archive and pages are
+ * served from that local archive through J2K's normal HttpPageLoader pipeline.
+ */
+class FtpSource(
+    private val context: Context,
+) : HttpSource(),
+    ConfigurableSource {
+
+    override val name = "FTP Library"
+    override val lang = "all"
+    override val supportsLatest = false
+
+    // Synthetic HTTP origin consumed by FtpInterceptor before any real HTTP request.
+    override val baseUrl = INTERNAL_BASE_URL
+
+    override val client: OkHttpClient by lazy {
+        network.client
+            .newBuilder()
+            .addInterceptor(FtpInterceptor())
+            .build()
+    }
+
+    override fun toString() = name
+
+    override suspend fun getPopularManga(page: Int): MangasPage {
+        if (page != 1) return MangasPage(emptyList(), false)
+        return MangasPage(listManga(query = ""), false)
+    }
+
+    override suspend fun getSearchManga(
+        page: Int,
+        query: String,
+        filters: FilterList,
+    ): MangasPage {
+        if (page != 1) return MangasPage(emptyList(), false)
+        return MangasPage(listManga(query), false)
+    }
+
+    override suspend fun getLatestUpdates(page: Int): MangasPage =
+        MangasPage(emptyList(), false)
+
+    private suspend fun listManga(query: String): List<SManga> =
+        withFtp { ftp, cfg ->
+            ftp.listFiles(cfg.root)
+                .asSequence()
+                .filter(FTPFile::isDirectory)
+                .filterNot { isHiddenOrSpecial(it.name) }
+                .filter { query.isBlank() || it.name.contains(query, ignoreCase = true) }
+                .sortedWith { a, b -> a.name.compareToCaseInsensitiveNaturalOrder(b.name) }
+                .map { dir ->
+                    val relative = dir.name
+                    val mangaPath = remotePath(cfg.root, relative)
+                    val cover = findCover(ftp, mangaPath)
+
+                    SManga.create().apply {
+                        title = dir.name
+                        url = relative
+                        thumbnail_url =
+                            cover?.let {
+                                buildFileInternalUrl(
+                                    cfg,
+                                    remotePath(mangaPath, it.name),
+                                )
+                            }
+                    }
+                }
+                .toList()
+        }
+
+    override suspend fun getMangaDetails(manga: SManga): SManga =
+        manga.apply {
+            initialized = true
+        }
+
+    override suspend fun getChapterList(manga: SManga): List<SChapter> =
+        withFtp { ftp, cfg ->
+            val mangaPath = remotePath(cfg.root, manga.url)
+
+            ftp.listFiles(mangaPath)
+                .asSequence()
+                .filterNot { isHiddenOrSpecial(it.name) }
+                .filter { it.isDirectory || (it.isFile && isArchiveName(it.name)) }
+                .map { chapterEntry ->
+                    SChapter.create().apply {
+                        url = "${manga.url}/${chapterEntry.name}"
+                        name =
+                            if (chapterEntry.isDirectory) {
+                                chapterEntry.name
+                            } else {
+                                chapterEntry.name.substringBeforeLast('.')
+                            }
+                        date_upload = 0L
+                        ChapterRecognition.parseChapterNumber(this, manga)
+                    }
+                }
+                .sortedWith { c1, c2 ->
+                    val numberOrder = c2.chapter_number.compareTo(c1.chapter_number)
+                    if (numberOrder != 0) {
+                        numberOrder
+                    } else {
+                        c2.name.compareToCaseInsensitiveNaturalOrder(c1.name)
+                    }
+                }
+                .toList()
+        }
+
+    override suspend fun getPageList(chapter: SChapter): List<Page> =
+        withFtp { ftp, cfg ->
+            val chapterPath = remotePath(cfg.root, chapter.url)
+            if (isArchiveName(chapterPath)) {
+                getArchivePages(ftp, cfg, chapterPath)
+            } else {
+                getDirectoryPages(ftp, cfg, chapterPath)
+            }
+        }
+
+    private fun getDirectoryPages(
+        ftp: FTPClient,
+        cfg: FtpConfig,
+        chapterPath: String,
+    ): List<Page> =
+        ftp.listFiles(chapterPath)
+            .asSequence()
+            .filter(FTPFile::isFile)
+            .filter { isImageName(it.name) }
+            .filterNot { isHiddenOrSpecial(it.name) }
+            .sortedWith { a, b -> a.name.compareToCaseInsensitiveNaturalOrder(b.name) }
+            .mapIndexed { index, file ->
+                val remoteFile = remotePath(chapterPath, file.name)
+                Page(
+                    index = index,
+                    imageUrl = buildFileInternalUrl(cfg, remoteFile),
+                )
+            }
+            .toList()
+
+    private fun getArchivePages(
+        ftp: FTPClient,
+        cfg: FtpConfig,
+        remoteArchive: String,
+    ): List<Page> {
+        val archiveFile = ensureArchiveCached(ftp, cfg, remoteArchive)
+
+        return ZipFile(archiveFile).use { zip ->
+            zip.entries()
+                .asSequence()
+                .filterNot { it.isDirectory }
+                .filter { isImageName(it.name) }
+                .filterNot { it.name.startsWith("__MACOSX/", ignoreCase = true) }
+                .sortedWith { a, b -> a.name.compareToCaseInsensitiveNaturalOrder(b.name) }
+                .mapIndexed { index, entry ->
+                    Page(
+                        index = index,
+                        imageUrl = buildArchiveInternalUrl(cfg, remoteArchive, entry.name),
+                    )
+                }
+                .toList()
+        }
+    }
+
+    override fun getFilterList() = FilterList()
+
+    override fun getMangaUrl(manga: SManga): String = baseUrl
+
+    override fun getChapterUrl(chapter: SChapter): String = baseUrl
+
+    /**
+     * Used by SourcePreferencesController.
+     */
+    suspend fun testConnection(): String =
+        withFtp { ftp, cfg ->
+            val entries = ftp.listFiles(cfg.root)
+            if (!FTPReply.isPositiveCompletion(ftp.replyCode)) {
+                throw IOException(
+                    "Could not list ${cfg.root}: ${ftp.replyString.trim()}",
+                )
+            }
+
+            val mangaFolders =
+                entries.count {
+                    it.isDirectory && !isHiddenOrSpecial(it.name)
+                }
+
+            "Connected to ${cfg.host}:${cfg.port} • $mangaFolders manga folder(s)"
+        }
+
+    /**
+     * Clears only the remote CBZ/ZIP cache; normal J2K chapter/image cache is untouched.
+     * Returns the number of bytes that were removed.
+     */
+    suspend fun clearArchiveCache(): Long =
+        withContext(Dispatchers.IO) {
+            val dir = archiveCacheDir
+            val bytes =
+                dir.walkTopDown()
+                    .filter(File::isFile)
+                    .sumOf(File::length)
+            dir.deleteRecursively()
+            dir.mkdirs()
+            bytes
+        }
+

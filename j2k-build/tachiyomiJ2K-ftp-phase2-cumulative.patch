+
+    private fun config(): FtpConfig {
+        val prefs = getSourcePreferences()
+        val host = prefs.getString(PREF_HOST, "").orEmpty().trim()
+        if (host.isBlank()) {
+            throw IOException(
+                "FTP host is not configured. Open FTP Library source settings first.",
+            )
+        }
+
+        val port =
+            prefs.getString(PREF_PORT, DEFAULT_PORT.toString())
+                ?.toIntOrNull()
+                ?.takeIf { it in 1..65535 }
+                ?: DEFAULT_PORT
+
+        val username =
+            prefs.getString(PREF_USERNAME, DEFAULT_USERNAME)
+                .orEmpty()
+                .ifBlank { DEFAULT_USERNAME }
+
+        val password = prefs.getString(PREF_PASSWORD, "").orEmpty()
+        val root = normalizeRoot(prefs.getString(PREF_ROOT, DEFAULT_ROOT).orEmpty())
+        val passive = prefs.getBoolean(PREF_PASSIVE, true)
+
+        return FtpConfig(
+            host = host,
+            port = port,
+            username = username,
+            password = password,
+            root = root,
+            passive = passive,
+        )
+    }
+
+    private suspend fun <T> withFtp(block: (FTPClient, FtpConfig) -> T): T =
+        withContext(Dispatchers.IO) {
+            val cfg = config()
+            val ftp = createConnectedClient(cfg)
+            try {
+                block(ftp, cfg)
+            } finally {
+                closeClient(ftp)
+            }
+        }
+
+    private fun findCover(
+        ftp: FTPClient,
+        mangaPath: String,
+    ): FTPFile? =
+        runCatching {
+            ftp.listFiles(mangaPath).firstOrNull { file ->
+                file.isFile &&
+                    file.name.substringBeforeLast('.', file.name)
+                        .equals("cover", ignoreCase = true) &&
+                    isImageName(file.name)
+            }
+        }.getOrNull()
+
+    private val archiveCacheDir: File
+        get() =
+            File(context.cacheDir, ARCHIVE_CACHE_DIRECTORY).apply {
+                if (!exists()) mkdirs()
+            }
+
+    /**
+     * Cache identity is endpoint + remote path. A small metadata file tracks remote
+     * size/MDTM so reopening a chapter can invalidate a changed archive.
+     */
+    private fun archiveCacheFile(
+        cfg: FtpConfig,
+        remoteArchive: String,
+    ): File {
+        val key = sha256("${endpointKey(cfg)}|$remoteArchive")
+        return File(archiveCacheDir, "$key.zip")
+    }
+
+    private fun archiveMetaFile(archive: File): File =
+        File(archive.parentFile, "${archive.name}.meta")
+
+    private fun ensureArchiveCached(
+        ftp: FTPClient,
+        cfg: FtpConfig,
+        remoteArchive: String,
+    ): File {
+        val target = archiveCacheFile(cfg, remoteArchive)
+        val meta = archiveMetaFile(target)
+        val fingerprint = remoteFingerprint(ftp, remoteArchive)
+
+        if (
+            target.isFile &&
+            target.length() > 0L &&
+            meta.isFile &&
+            runCatching { meta.readText() }.getOrNull() == fingerprint
+        ) {
+            target.setLastModified(System.currentTimeMillis())
+            return target
+        }
+
+        val tmp = File(target.parentFile, "${target.name}.tmp")
+        tmp.delete()
+
+        try {
+            FileOutputStream(tmp).use { output ->
+                if (!ftp.retrieveFile(remoteArchive, output)) {
+                    throw IOException(
+                        "FTP download failed for $remoteArchive: ${ftp.replyString.trim()}",
+                    )
+                }
+            }
+
+            if (tmp.length() <= 0L) {
+                throw IOException("Downloaded archive is empty: $remoteArchive")
+            }
+
+            target.delete()
+            if (!tmp.renameTo(target)) {
+                tmp.copyTo(target, overwrite = true)
+                tmp.delete()
+            }
+            meta.writeText(fingerprint)
+            target.setLastModified(System.currentTimeMillis())
+            trimArchiveCache(target)
+            return target
+        } catch (t: Throwable) {
+            tmp.delete()
+            throw t
+        }
+    }
+
+    private fun remoteFingerprint(
+        ftp: FTPClient,
+        remoteArchive: String,
+    ): String {
+        val size =
+            runCatching {
+                ftp.mlistFile(remoteArchive)?.size
+                    ?: findRemoteFile(ftp, remoteArchive)?.size
+                    ?: -1L
+            }.getOrDefault(-1L)
+
+        val modified =
+            runCatching {
+                ftp.getModificationTime(remoteArchive).orEmpty().trim()
+            }.getOrDefault("")
+
+        return "$size|$modified"
+    }
+
+    private fun findRemoteFile(
+        ftp: FTPClient,
+        path: String,
+    ): FTPFile? {
+        val parent = path.substringBeforeLast('/', "/").ifBlank { "/" }
+        val name = path.substringAfterLast('/')
+        return ftp.listFiles(parent).firstOrNull { it.name == name }
+    }
+
+    private fun trimArchiveCache(keep: File) {
+        val archives =
+            archiveCacheDir.listFiles()
+                .orEmpty()
+                .filter { it.isFile && it.extension.equals("zip", ignoreCase = true) }
+                .sortedBy(File::lastModified)
+
+        var total = archives.sumOf(File::length)
+        if (total <= MAX_ARCHIVE_CACHE_BYTES) return
+
+        for (file in archives) {
+            if (total <= MAX_ARCHIVE_CACHE_BYTES) break
+            if (file == keep) continue
+
+            val size = file.length()
+            if (file.delete()) {
+                archiveMetaFile(file).delete()
+                total -= size
+            }
+        }
+    }
+
+    private inner class FtpInterceptor : Interceptor {
+        override fun intercept(chain: Interceptor.Chain): Response {
+            val request = chain.request()
+            if (request.url.host != INTERNAL_HOST) {
+                return chain.proceed(request)
+            }
+
+            val kind = request.url.pathSegments.firstOrNull()
+            return when (kind) {
+                PATH_FILE -> interceptRemoteFile(request)
+                PATH_ARCHIVE -> interceptArchiveEntry(request)
+                else -> throw IOException("Unknown internal FTP request: ${request.url}")
+            }
+        }
+
+        private fun interceptRemoteFile(request: Request): Response {
+            val remotePath =
+                request.url.pathSegments.getOrNull(2)
+                    ?.let(::decodeToken)
+                    ?: throw IOException("Invalid internal FTP file URL")
+
+            val cfg = config()
+            val ftp = createConnectedClient(cfg)
+
+            try {
+                val size =
+                    runCatching {
+                        ftp.mlistFile(remotePath)?.size
+                            ?: findRemoteFile(ftp, remotePath)?.size
+                            ?: -1L
+                    }.getOrDefault(-1L)
+
+                val stream =
+                    ftp.retrieveFileStream(remotePath)
+                        ?: throw IOException(
+                            "FTP RETR failed for $remotePath: ${ftp.replyString.trim()}",
+                        )
+
+                val body =
+                    FtpResponseBody(
+                        ftp = ftp,
+                        remotePath = remotePath,
+                        input = stream,
+                        length = size,
+                    )
+
+                return successResponse(request, remotePath, size, body)
+            } catch (t: Throwable) {
+                closeClient(ftp)
+                throw t
+            }
+        }
+
+        private fun interceptArchiveEntry(request: Request): Response {
+            val segments = request.url.pathSegments
+            if (segments.size < 4) {
+                throw IOException("Invalid internal FTP archive URL")
+            }
+
+            val remoteArchive = decodeToken(segments[2])
+            val entryName = decodeToken(segments[3])
+            val cfg = config()
+            var archive = archiveCacheFile(cfg, remoteArchive)
+
+            if (!archive.isFile || archive.length() <= 0L) {
+                val ftp = createConnectedClient(cfg)
+                try {
+                    archive = ensureArchiveCached(ftp, cfg, remoteArchive)
+                } finally {
+                    closeClient(ftp)
+                }
+            }
+
+            val zip = ZipFile(archive)
+            try {
+                val entry =
+                    zip.getEntry(entryName)
+                        ?: throw IOException(
+                            "Archive entry not found: $entryName",
+                        )
+
+                val body =
+                    ZipEntryResponseBody(
+                        zip = zip,
+                        entryName = entry.name,
+                        input = zip.getInputStream(entry),
+                        length = entry.size,
+                    )
+
+                return successResponse(
+                    request = request,
+                    contentPath = entry.name,
+                    length = entry.size,
+                    body = body,
+                )
+            } catch (t: Throwable) {
+                runCatching { zip.close() }
+                throw t
+            }
+        }
+
+        private fun successResponse(
+            request: Request,
+            contentPath: String,
+            length: Long,
+            body: ResponseBody,
+        ): Response =
+            Response.Builder()
+                .request(request)
+                .protocol(Protocol.HTTP_1_1)
+                .code(200)
+                .message("OK")
+                .header(
+                    "Content-Type",
+                    mediaTypeFor(contentPath)?.toString() ?: "application/octet-stream",
+                )
+                .apply {
+                    if (length >= 0L) {
+                        header("Content-Length", length.toString())
+                    }
+                }
+                .body(body)
+                .build()
+    }
+
+    /**
+     * ResponseBody owning an FTP data connection. Closing the body finalizes RETR.
+     */
+    private class FtpResponseBody(
+        private val ftp: FTPClient,
+        private val remotePath: String,
+        input: java.io.InputStream,
+        private val length: Long,
+    ) : ResponseBody() {
+
+        private var closed = false
+
+        private val bufferedSource: BufferedSource =
+            object : ForwardingSource(input.source()) {
+                override fun close() {
+                    if (closed) return
+                    closed = true
+
+                    try {
+                        super.close()
+                    } finally {
+                        runCatching { ftp.completePendingCommand() }
+                        closeClient(ftp)
+                    }
+                }
+            }.buffer()
+
+        override fun contentType(): MediaType? = mediaTypeFor(remotePath)
+
+        override fun contentLength(): Long = length
+
+        override fun source(): BufferedSource = bufferedSource
+    }
+
+    /**
+     * ResponseBody owning a ZipFile so the archive stays open while Coil/J2K reads
+     * the entry stream.
+     */
+    private class ZipEntryResponseBody(
+        private val zip: ZipFile,
+        private val entryName: String,
+        input: java.io.InputStream,
+        private val length: Long,
+    ) : ResponseBody() {
+
+        private var closed = false
+
+        private val bufferedSource: BufferedSource =
+            object : ForwardingSource(input.source()) {
+                override fun close() {
+                    if (closed) return
+                    closed = true
+
+                    try {
+                        super.close()
+                    } finally {
+                        runCatching { zip.close() }
+                    }
+                }
+            }.buffer()
+
+        override fun contentType(): MediaType? = mediaTypeFor(entryName)
+
+        override fun contentLength(): Long = length
+
+        override fun source(): BufferedSource = bufferedSource
+    }
+
+    private data class FtpConfig(
+        val host: String,
+        val port: Int,
+        val username: String,
+        val password: String,
+        val root: String,
+        val passive: Boolean,
+    )
+
+    companion object {
+        private const val INTERNAL_HOST = "ftp.tachiyomij2k.invalid"
+        private const val INTERNAL_BASE_URL = "https://$INTERNAL_HOST"
+        private const val PATH_FILE = "file"
+        private const val PATH_ARCHIVE = "archive"
+
+        private const val DEFAULT_PORT = 21
+        private const val DEFAULT_ROOT = "/Manga"
+        private const val DEFAULT_USERNAME = "anonymous"
+
+        private const val PREF_HOST = "ftp_host"
+        private const val PREF_PORT = "ftp_port"
+        private const val PREF_USERNAME = "ftp_username"
+        private const val PREF_PASSWORD = "ftp_password"
+        private const val PREF_ROOT = "ftp_root"
+        private const val PREF_PASSIVE = "ftp_passive"
+
+        private const val ARCHIVE_CACHE_DIRECTORY = "ftp-archives"
+        private const val MAX_ARCHIVE_CACHE_BYTES = 512L * 1024L * 1024L
+
+        private val IMAGE_EXTENSIONS =
+            setOf(
+                "jpg",
+                "jpeg",
+                "png",
+                "webp",
+                "gif",
+                "avif",
+                "jxl",
+                "bmp",
+            )
+
+        private val ARCHIVE_EXTENSIONS = setOf("cbz", "zip")
+
+        private fun isImageName(name: String): Boolean =
+            name.substringAfterLast('.', "").lowercase() in IMAGE_EXTENSIONS
+
+        private fun isArchiveName(name: String): Boolean =
+            name.substringAfterLast('.', "").lowercase() in ARCHIVE_EXTENSIONS
+
+        private fun isHiddenOrSpecial(name: String): Boolean =
+            name == "." || name == ".." || name.startsWith('.')
+
+        private fun normalizeRoot(root: String): String {
+            val normalized = root.trim().replace('\\', '/').ifBlank { "/" }
+            val withLeadingSlash =
+                if (normalized.startsWith('/')) {
+                    normalized
+                } else {
+                    "/$normalized"
+                }
+            return if (withLeadingSlash.length > 1) {
+                withLeadingSlash.trimEnd('/')
+            } else {
+                "/"
+            }
+        }
+
+        private fun remotePath(
+            base: String,
+            child: String,
+        ): String {
+            val b = if (base == "/") "" else base.trimEnd('/')
+            val c = child.replace('\\', '/').trim('/')
+            return "$b/$c".ifBlank { "/" }
+        }
+
+        private fun createConnectedClient(cfg: FtpConfig): FTPClient {
+            val ftp =
+                FTPClient().apply {
+                    controlEncoding = "UTF-8"
+                    connectTimeout = 15_000
+                    defaultTimeout = 15_000
+                    setDataTimeout(30_000)
+                }
+
+            try {
+                ftp.connect(cfg.host, cfg.port)
+
+                if (!FTPReply.isPositiveCompletion(ftp.replyCode)) {
+                    throw IOException(
+                        "FTP server rejected connection: ${ftp.replyString.trim()}",
+                    )
+                }
+
+                if (!ftp.login(cfg.username, cfg.password)) {
+                    throw IOException(
+                        "FTP login failed: ${ftp.replyString.trim()}",
+                    )
+                }
+
+                if (!ftp.setFileType(FTP.BINARY_FILE_TYPE)) {
+                    throw IOException("FTP server rejected binary transfer mode")
+                }
+
+                if (cfg.passive) {
+                    ftp.enterLocalPassiveMode()
+                } else {
+                    ftp.enterLocalActiveMode()
+                }
+
+                return ftp
+            } catch (t: Throwable) {
+                closeClient(ftp)
+                throw t
+            }
+        }
+
+        private fun closeClient(ftp: FTPClient) {
+            runCatching {
+                if (ftp.isConnected) ftp.logout()
+            }
+            runCatching {
+                if (ftp.isConnected) ftp.disconnect()
+            }
+        }
+
+        private fun endpointKey(cfg: FtpConfig): String =
+            sha256(
+                "${cfg.host}:${cfg.port}:${cfg.username}:${cfg.root}",
+            ).take(16)
+
+        private fun buildFileInternalUrl(
+            cfg: FtpConfig,
+            remoteFile: String,
+        ): String =
+            "$INTERNAL_BASE_URL/$PATH_FILE/${endpointKey(cfg)}/${encodeToken(remoteFile)}"
+
+        private fun buildArchiveInternalUrl(
+            cfg: FtpConfig,
+            remoteArchive: String,
+            entryName: String,
+        ): String =
+            "$INTERNAL_BASE_URL/$PATH_ARCHIVE/${endpointKey(cfg)}/" +
+                "${encodeToken(remoteArchive)}/${encodeToken(entryName)}"
+
+        private fun encodeToken(value: String): String =
+            Base64.encodeToString(
+                value.toByteArray(StandardCharsets.UTF_8),
+                Base64.URL_SAFE or Base64.NO_WRAP or Base64.NO_PADDING,
+            )
+
+        private fun decodeToken(token: String): String =
+            try {
+                String(
+                    Base64.decode(
+                        token,
+                        Base64.URL_SAFE or Base64.NO_WRAP or Base64.NO_PADDING,
+                    ),
+                    StandardCharsets.UTF_8,
+                )
+            } catch (e: IllegalArgumentException) {
+                throw IOException("Invalid internal FTP path token", e)
+            }
+
+        private fun sha256(value: String): String =
+            MessageDigest.getInstance("SHA-256")
+                .digest(value.toByteArray(StandardCharsets.UTF_8))
+                .joinToString("") { "%02x".format(it) }
+
+        private fun mediaTypeFor(path: String): MediaType? =
+            when (path.substringAfterLast('.', "").lowercase()) {
+                "jpg", "jpeg" -> "image/jpeg"
+                "png" -> "image/png"
+                "webp" -> "image/webp"
+                "gif" -> "image/gif"
+                "avif" -> "image/avif"
+                "jxl" -> "image/jxl"
+                "bmp" -> "image/bmp"
+                else -> "application/octet-stream"
+            }.toMediaTypeOrNull()
+    }
+}

+/* V3.91 — automatic system-language detection.
+   A language explicitly chosen by the user remains authoritative. If no manual
+   choice exists yet, detect the browser/OS language on every launch. */
+function detectSystemHomeLanguage(){
+  const aliases={
+    id:'id',in:'id',
+    en:'en',
+    zh:'zh',
+    ja:'ja',
+    ms:'ms',
+    th:'th',
+    vi:'vi',
+    fil:'fil',tl:'fil',
+    my:'my',
+    km:'km',
+    lo:'lo',
+    tet:'tet',
+    pt:'pt',
+    ta:'ta'
+  };
+  let systemLanguages=[];
+  try{
+    if(Array.isArray(navigator.languages))systemLanguages.push(...navigator.languages);
+    if(navigator.language)systemLanguages.push(navigator.language);
+  }catch(e){}
+  for(const raw of systemLanguages){
+    const tag=String(raw||'').trim().toLowerCase().replace(/_/g,'-');
+    if(!tag)continue;
+    if(HOME_I18N[tag])return tag;
+    const base=tag.split('-')[0];
+    const mapped=aliases[base];
+    if(mapped&&HOME_I18N[mapped])return mapped;
+  }
+  // Unsupported system languages use the international English pack rather
+  // than silently assuming Indonesian.
+  return 'en';
+}
